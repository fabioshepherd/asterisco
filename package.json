    "notices": "cargo about generate --manifest-path src-tauri/Cargo.toml src-tauri/about.hbs > THIRD-PARTY-NOTICES-rust.txt && bunx generate-license-file --input package.json --output THIRD-PARTY-NOTICES-npm.txt --overwrite --ci --no-spinner --eol lf && cat THIRD-PARTY-NOTICES-rust.txt THIRD-PARTY-NOTICES-npm.txt > src-tauri/THIRD-PARTY-NOTICES.txt"
  },
